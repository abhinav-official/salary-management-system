# Local HTTP only. For deployment, use HTTPS and COOKIE_SECURE=true.
WEB_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional first-start custom account: set BOTH values, otherwise demo is seeded.
# Existing persisted accounts are never changed by these settings.
HR_EMAIL=
# To set a custom password hash, append: python3 tools/hash_password.py >> .env
